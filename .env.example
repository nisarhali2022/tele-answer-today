# Public Supabase CMS read access. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resolve the CMS website record during local and Vercel preview requests.
CMS_SITE_DOMAIN=teleanswertoday.pk

# Must exactly match this website's encrypted revalidation secret in the Admin CMS.
CMS_REVALIDATION_SECRET=replace-with-a-long-random-secret

# Optional: link the retired local quiz page to the shared Admin CMS.
NEXT_PUBLIC_CMS_ADMIN_URL=https://your-admin-cms.example

# Set true only when production ads must be paused.
DISABLE_ADSENSE=false
